{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "سامانه طراحی سه‌بعدی ردیابی خودرو، GPS و مدیریت ناوگان",
    "version": "2.0.0",
    "direction": "rtl",
    "locale": "fa-IR",
    "singleSourceOfTruth": true
  },
  "color": {
    "brand": {
      "signal-orange": {
        "$value": "#FF742E",
        "$type": "color",
        "$description": "نارنجی سیگنال زنده و انرژی حرکت — HSL(20.1°, 100%, 59%) | OKLCH(71.6%, 0.187, 43.8°)"
      },
      "deep-navy": {
        "$value": "#102333",
        "$type": "color",
        "$description": "سرمه‌ای راداری برند — HSL(207.4°, 52.2%, 13.1%) | OKLCH(24.8%, 0.040, 245.7°)"
      },
      "warm-sand": {
        "$value": "#E8DECD",
        "$type": "color",
        "$description": "بژ گرم خاکی برای قطبیت روز و خوانایی ۱۲.۰۳:۱ با سرمه‌ای — HSL(37.8°, 37%, 85.7%)"
      }
    },
    "scale": {
      "orange": {
        "100": { "$value": "#FFE4D4", "$type": "color" },
        "200": { "$value": "#FFC5A6", "$type": "color" },
        "300": { "$value": "#FFB085", "$type": "color", "$description": "نارنجی روشن برچسب‌های تیره با کنتراست بالا" },
        "350": { "$value": "#FF9861", "$type": "color", "$description": "نارنجی ملایم متن کپسول‌ها روی زمینه تیره" },
        "400": { "$value": "#FF8B4D", "$type": "color" },
        "500": { "$value": "#FF742E", "$type": "color" },
        "600": { "$value": "#EC601B", "$type": "color", "$description": "پایان گرادیان دکمه اصلی با کنتراست >= 4.7:1 در برابر #060E16" },
        "700": { "$value": "#B84309", "$type": "color" },
        "800": { "$value": "#9E3805", "$type": "color", "$description": "لبه اکسترودشده زیرین دکمه نارنجی سه‌بعدی" }
      },
      "navy": {
        "25":  { "$value": "#9CC2DD", "$type": "color", "$description": "نور محیطی سرد آسمان در صحنه‌های سه‌بعدی" },
        "50":  { "$value": "#58768B", "$type": "color" },
        "100": { "$value": "#3D5768", "$type": "color", "$description": "ایستگاه ۰٪ گرادیان افق در gradiant.pdf" },
        "200": { "$value": "#2D4658", "$type": "color", "$description": "ریل پایه مسیر بزرگراه پیش از عبور سیگنال" },
        "300": { "$value": "#213D4F", "$type": "color", "$description": "ایستگاه ۷۸.۶۱٪ بازتاب ثانویه در gradiant.pdf" },
        "400": { "$value": "#132D3F", "$type": "color", "$description": "ایستگاه ۱۰۰٪ گرادیان افق در gradiant.pdf" },
        "500": { "$value": "#112835", "$type": "color", "$description": "ایستگاه ۴۱.۵۸٪ شکم تاریک S-Curve در gradiant.pdf" },
        "600": { "$value": "#102333", "$type": "color", "$description": "سرمه‌ای مادر برند از COLORS.md" },
        "700": { "$value": "#0B1926", "$type": "color" },
        "800": { "$value": "#08141F", "$type": "color" },
        "900": { "$value": "#060E16", "$type": "color", "$description": "بوم پایه اتاق فرمان شبانه" },
        "950": { "$value": "#050B12", "$type": "color" }
      },
      "sand": {
        "50":  { "$value": "#F7F5F0", "$type": "color", "$description": "زمینه پلاک خودرو و کارت‌های روشن برجسته" },
        "100": { "$value": "#F6EFE4", "$type": "color" },
        "200": { "$value": "#EDE4D5", "$type": "color" },
        "300": { "$value": "#E8DECD", "$type": "color", "$description": "بژ گرم مادر برند از COLORS.md" },
        "400": { "$value": "#DFD2BC", "$type": "color" },
        "500": { "$value": "#C8B89E", "$type": "color" }
      },
      "neutral": {
        "white": { "$value": "#FFFFFF", "$type": "color" },
        "black": { "$value": "#000000", "$type": "color" },
        "pcb":   { "$value": "#0E3B33", "$type": "color", "$description": "رنگ برد مدار چاپی ردیاب سخت‌افزاری" }
      }
    },
    "plate": {
      "blue":   { "$value": "#123B7A", "$type": "color", "$description": "نوار آبی استاندارد پلاک ایران" },
      "yellow": { "$value": "#FACC15", "$type": "color", "$description": "زمینه زرد پلاک عمومی و سنگین ایران" },
      "green":  { "$value": "#22C55E", "$type": "color", "$description": "سبز پرچم پلاک" },
      "red":    { "$value": "#EF4444", "$type": "color", "$description": "قرمز پرچم پلاک" }
    },
    "telemetry": {
      "moving":     { "$value": "#45C06A", "$type": "color", "$description": "حرکت فعال ناوگان — OKLCH(72.0%, 0.165, 150°)" },
      "signal":     { "$value": "#FF742E", "$type": "color", "$description": "پالس فعال GPS و سیگنال مادر — OKLCH(71.6%, 0.187, 43.8°)" },
      "corridor":   { "$value": "#00B4EC", "$type": "color", "$description": "کریدور ترانزیتی فعال — OKLCH(72.0%, 0.143, 230°)" },
      "cold-chain": { "$value": "#00BBC0", "$type": "color", "$description": "سنسور زنجیره سرد یخچالی — OKLCH(72.0%, 0.122, 198°)" },
      "idle":       { "$value": "#D0A500", "$type": "color", "$description": "توقف با موتور روشن — OKLCH(74.0%, 0.151, 90°)" },
      "critical":   { "$value": "#FF6F69", "$type": "color", "$description": "خروج اضطراری از ژئوفنس — OKLCH(71.6%, 0.177, 25°)" }
    }
  },
  "semantic": {
    "nocturnal": {
      "surface":          "var(--ds-navy-900)",
      "surface-raised":   "color-mix(in srgb, var(--ds-navy-500) 86%, var(--ds-navy-900))",
      "surface-sunken":   "var(--ds-navy-950)",
      "surface-glass":    "color-mix(in srgb, var(--ds-navy-700) 84%, transparent)",
      "on-surface":       "var(--ds-sand-300)",
      "on-surface-muted": "color-mix(in srgb, var(--ds-sand-300) 76%, var(--ds-navy-900))",
      "on-surface-dim":   "color-mix(in srgb, var(--ds-sand-300) 68%, var(--ds-navy-900))",
      "accent":           "var(--ds-color-signal-orange)",
      "accent-soft":      "var(--ds-orange-300)",
      "on-accent":        "var(--ds-navy-900)",
      "border":           "color-mix(in srgb, var(--ds-sand-300) 18%, transparent)",
      "border-strong":    "color-mix(in srgb, var(--ds-color-signal-orange) 48%, transparent)",
      "focus-ring":       "var(--ds-color-signal-orange)"
    },
    "daylight": {
      "surface":          "var(--ds-sand-300)",
      "surface-raised":   "var(--ds-sand-100)",
      "surface-sunken":   "var(--ds-sand-400)",
      "surface-glass":    "color-mix(in srgb, var(--ds-sand-50) 86%, transparent)",
      "on-surface":       "var(--ds-navy-600)",
      "on-surface-muted": "color-mix(in srgb, var(--ds-navy-600) 78%, var(--ds-sand-300))",
      "on-surface-dim":   "color-mix(in srgb, var(--ds-navy-600) 72%, var(--ds-sand-300))",
      "accent":           "var(--ds-color-signal-orange)",
      "accent-soft":      "var(--ds-navy-600)",
      "on-accent":        "var(--ds-navy-900)",
      "border":           "color-mix(in srgb, var(--ds-navy-600) 16%, transparent)",
      "border-strong":    "color-mix(in srgb, var(--ds-navy-600) 36%, transparent)",
      "focus-ring":       "var(--ds-navy-600)"
    }
  },
  "spacing": {
    "baseModuleS": 23.145,
    "scale": {
      "0_25s": { "$value": "5.79px",   "$type": "dimension", "$description": "0.25 × S — فاصله‌های ریز درون چیپ و پلاک" },
      "0_5s":  { "$value": "11.57px",  "$type": "dimension", "$description": "0.5 × S — معادل شعاع پایانه لوگو" },
      "0_75s": { "$value": "17.36px",  "$type": "dimension", "$description": "0.75 × S — پدینگ فشرده کارت‌های تله‌متری" },
      "1s":    { "$value": "23.15px",  "$type": "dimension", "$description": "1 × S — واحد پایه ضخامت نوار لوگو" },
      "1_5s":  { "$value": "34.72px",  "$type": "dimension", "$description": "1.5 × S — گپ ستون‌های اصلی و پدینگ کارت بزرگ" },
      "2s":    { "$value": "46.29px",  "$type": "dimension", "$description": "2 × S — فاصله سرصفحه بخش‌ها" },
      "3s":    { "$value": "69.44px",  "$type": "dimension", "$description": "3 × S — پدینگ عمودی بخش‌ها در موبایل" },
      "4s":    { "$value": "92.58px",  "$type": "dimension", "$description": "4 × S — پدینگ عمودی استاندارد بخش‌ها" },
      "6s":    { "$value": "138.87px", "$type": "dimension", "$description": "6 × S — فضای تنفس بالای بخش قهرمان" }
    }
  },
  "gradient": {
    "clearcoat": {
      "$value": "linear-gradient(140.24deg, var(--ds-navy-100) 0%, var(--ds-navy-500) 41.58%, var(--ds-navy-300) 78.61%, var(--ds-navy-400) 100%)",
      "$type": "gradient"
    },
    "signal-flare": {
      "$value": "linear-gradient(155deg, var(--ds-orange-400) 0%, var(--ds-color-signal-orange) 52%, var(--ds-orange-600) 100%)",
      "$type": "gradient"
    },
    "daylight-sand": {
      "$value": "linear-gradient(180deg, var(--ds-sand-200) 0%, var(--ds-sand-300) 55%, var(--ds-sand-400) 100%)",
      "$type": "gradient"
    },
    "cushion-light": {
      "$value": "linear-gradient(145deg, var(--ds-sand-100) 0%, var(--ds-sand-200) 100%)",
      "$type": "gradient"
    },
    "card-nocturnal": {
      "$value": "linear-gradient(155deg, color-mix(in srgb, var(--ds-navy-400) 86%, transparent) 0%, color-mix(in srgb, var(--ds-navy-800) 94%, transparent) 100%)",
      "$type": "gradient"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Peyda', Tahoma, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "weights": {
      "light":     300,
      "regular":   400,
      "medium":    500,
      "semibold":  600,
      "bold":      700,
      "extrabold": 800,
      "black":     900
    },
    "sizes": {
      "hero": "clamp(2.125rem, 3.8vw, 3.375rem)",
      "h1":   "clamp(1.75rem, 3.2vw, 2.625rem)",
      "h2":   "clamp(1.5rem, 2.6vw, 2.125rem)",
      "h3":   "1.3125rem",
      "lg":   "1rem",
      "md":   "0.9375rem",
      "sm":   "0.875rem",
      "xs":   "0.78125rem"
    }
  },
  "geometry": {
    "stroke-s":      "23.145px",
    "unit-u":        "23.86px",
    "cap-r":         "11.57px",
    "golden-fillet": "14.54px",
    "squircle":      "31.25%",
    "zero-squircle": "43.4%",
    "golden-split":  "38.06%",
    "kaf-skew":      "-26.84deg",
    "radar-cone":    "30.6deg",
    "pin-blade":     "136.54deg",
    "nuqta-grid":    "24px"
  },
  "material3d": {
    "pbr": {
      "roughness": 0.4,
      "metalness": 0.08,
      "clearcoat": 0.35,
      "clearcoatRoughness": 0.28,
      "ambientIntensity": 0.5
    },
    "modeACushion": {
      "inflatePercent": 76,
      "bevelWidthPercent": 50,
      "elevationDeg": 71,
      "azimuthDeg": -124.7
    },
    "modeBChisel": {
      "extrudePt": 175.5,
      "bevelWidthPercent": 60,
      "elevationDeg": 43.08,
      "azimuthDeg": -149.74
    },
    "zLayers": {
      "nuqta": 0,
      "corridor": 10,
      "clearcoat": 20,
      "tactile": 30,
      "webgl": 40,
      "navbar": 60,
      "modal": 120
    }
  },
  "motion": {
    "easing": {
      "spring-lock":     "cubic-bezier(0.34, 1.45, 0.64, 1)",
      "clothoid-cruise": "cubic-bezier(0.65, 0, 0.35, 1)",
      "shockwave":       "cubic-bezier(0.16, 1, 0.3, 1)",
      "tilt":            "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "duration": {
      "instant": "120ms",
      "tactile": "180ms",
      "morph":   "280ms",
      "route":   "550ms",
      "sonar":   "1800ms"
    }
  },
  "radius": {
    "nuqta":    "3px",
    "plate":    "7px",
    "sm":       "10px",
    "cap":      "12px",
    "fillet":   "15px",
    "md":       "18px",
    "card-md":  "22px",
    "card-lg":  "30px",
    "stage":    "48px",
    "squircle": "31.25%",
    "capsule":  "9999px"
  },
  "elevation": {
    "btn-orange": "0 5px 0 var(--ds-orange-800), 0 14px 30px color-mix(in srgb, var(--ds-color-signal-orange) 42%, transparent), inset 0 1px 1px color-mix(in srgb, var(--ds-neutral-white) 60%, transparent)",
    "btn-orange-hover": "0 7px 0 var(--ds-orange-800), 0 20px 38px color-mix(in srgb, var(--ds-color-signal-orange) 55%, transparent), inset 0 1px 2px color-mix(in srgb, var(--ds-neutral-white) 75%, transparent)",
    "btn-orange-active": "0 2px 0 var(--ds-orange-800), 0 8px 18px color-mix(in srgb, var(--ds-color-signal-orange) 35%, transparent)",
    "btn-navy": "0 5px 0 var(--ds-navy-950), 0 14px 28px color-mix(in srgb, var(--ds-neutral-black) 42%, transparent), inset 0 1px 0 color-mix(in srgb, var(--ds-neutral-white) 22%, transparent)",
    "cushion-light": "14px 18px 38px color-mix(in srgb, var(--ds-navy-600) 14%, transparent), -8px -8px 24px color-mix(in srgb, var(--ds-neutral-white) 65%, transparent), inset 0 1px 2px color-mix(in srgb, var(--ds-neutral-white) 90%, transparent)",
    "chisel-navy": "0 24px 52px color-mix(in srgb, var(--ds-neutral-black) 46%, transparent), inset 0 2px 2px color-mix(in srgb, var(--ds-neutral-white) 20%, transparent), inset 0 -3px 6px color-mix(in srgb, var(--ds-neutral-black) 45%, transparent)",
    "card": "0 22px 54px color-mix(in srgb, var(--ds-neutral-black) 42%, transparent), inset 0 1px 0 color-mix(in srgb, var(--ds-sand-300) 10%, transparent)",
    "navbar": "0 20px 50px color-mix(in srgb, var(--ds-neutral-black) 50%, transparent), inset 0 1px 0 color-mix(in srgb, var(--ds-neutral-white) 16%, transparent)",
    "glow-accent": "0 0 22px color-mix(in srgb, var(--ds-color-signal-orange) 68%, transparent)",
    "glow-dot": "0 0 14px var(--ds-color-signal-orange)",
    "glow-segment": "0 0 10px color-mix(in srgb, var(--gauge-color, var(--ds-accent)) 48%, transparent)",
    "modal": "0 36px 90px color-mix(in srgb, var(--ds-neutral-black) 72%, transparent), 0 0 60px color-mix(in srgb, var(--ds-color-signal-orange) 14%, transparent)",
    "drawer": "-16px 0 48px color-mix(in srgb, var(--ds-neutral-black) 60%, transparent)",
    "stage": "0 30px 70px color-mix(in srgb, var(--ds-neutral-black) 50%, transparent), inset 0 1px 0 color-mix(in srgb, var(--ds-neutral-white) 10%, transparent)",
    "inset-stage": "inset 0 2px 18px color-mix(in srgb, var(--ds-neutral-black) 55%, transparent)"
  },
  "breakpoints": {
    "sm": "640px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
